#!/usr/bin/env bash
# install_tools - Universal Environment Bootstrapper (Mise-First Architecture)

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/detect.sh
source "$SCRIPT_DIR/lib/detect.sh"

echo "========================================"
echo "🚀 Starting System Dependencies & Mise Engine..."
echo "========================================"

# --- Argument Parsing ---
ENV_TYPE=""
INSTALL_GUI=false

while [[ "$#" -gt 0 ]]; do
  case $1 in
  --env=*) ENV_TYPE="${1#*=}" ;;
  --gui) INSTALL_GUI=true ;;
  esac
  shift
done

# Falls back to self-detection when run standalone (not via `setup`).
[ -z "$ENV_TYPE" ] && ENV_TYPE="$(detect_env_type)"
PKG_MGR="$(detect_pkg_mgr)"

_has() { command -v "$1" >/dev/null 2>&1; }

# Sudo wrapper: runs directly when sudo is absent (rootless containers, Termux).
# This makes every 'sudo <cmd>' below safe in CI and minimal environments.
_sudo() {
  if _has sudo; then
    sudo "$@"
  else
    "$@"
  fi
}

# Reads a plain-text manifest under packages/ (one package per line, '#' comments allowed).
_read_manifest() {
  local file="$SCRIPT_DIR/packages/$1"
  [ -f "$file" ] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$file"
}

# ==========================================
# ⚙️ 1. OS-LEVEL PREREQUISITES
# ==========================================

# --- Pull corporate certs before downloading anything else ---
# Only necessary on WSL to bridge the Windows Trust Store into the Linux subsystem
if [ "$ENV_TYPE" = "wsl" ]; then
  CERT_SCRIPT="$HOME/.dotfiles/scripts/scripts/sync_certs"
  if [ -f "$CERT_SCRIPT" ]; then
    echo "🔄 Running Zscaler Certificate Sync..."
    bash "$CERT_SCRIPT"
  fi
fi

# Native Docker Engine + DevPod CLI, shared across every native-Linux package manager.
# Skipped inside containers/WSL, where Docker is either unavailable or host-provided.
_install_linux_lifelines() {
  if [ "$ENV_TYPE" != "container" ] && [ "$ENV_TYPE" != "wsl" ] && ! _has docker; then
    echo "🐳 Installing native Docker Engine..."
    # Pipe directly to sh — never mutate a downloaded script before execution.
    # TODO: pin a version + checksum instead of trusting the live install script.
    curl -fsSL https://get.docker.com | _sudo sh
    _sudo usermod -aG docker "${USER:-$(id -un)}"
    echo "⚠️ Docker installed. (Log out and back in for group permissions to apply)."
  fi

  if ! _has devpod; then
    echo "🚀 Installing DevPod CLI..."
    curl -L -o devpod "https://github.com/loft-sh/devpod/releases/latest/download/devpod-linux-amd64"
    _sudo install -c -m 0755 devpod /usr/local/bin
    rm devpod
  fi
}

case "$PKG_MGR" in
pkg)
  echo "📱 Termux detected. Installing system base..."
  pkg update -y
  mapfile -t TERMUX_BASE < <(_read_manifest packages.termux)
  pkg install -y "${TERMUX_BASE[@]}"

  # Termux fallback: If mise struggles with ARM Android, install core natively
  if ! _has eza; then
    pkg install -y eza bat fzf zoxide starship neovim
  fi
  ;;

brew)
  echo "🍏 macOS detected. Installing system base via Homebrew..."
  brew bundle --file="$SCRIPT_DIR/packages/Brewfile"
  ;;

apt)
  echo "🐧 Debian-based system detected. Installing lifelines via apt..."
  _sudo apt-get update -y
  mapfile -t APT_BASE < <(_read_manifest packages.apt)
  _sudo apt-get install -y "${APT_BASE[@]}"

  # Ubuntu calls bat 'batcat', fix for system scripts that expect 'bat'
  mkdir -p ~/.local/bin
  [ -f /usr/bin/batcat ] && ln -sf /usr/bin/batcat ~/.local/bin/bat

  # --- Native GUI Applications ---
  if [ "$INSTALL_GUI" = true ]; then
    echo "🖥️  Installing Native GUI Applications..."
    mapfile -t APT_GUI < <(_read_manifest gui.apt)
    _sudo apt-get install -y "${APT_GUI[@]}"
  fi

  _install_linux_lifelines
  ;;

dnf)
  echo "🎩 Fedora/RHEL system detected. Installing lifelines via dnf..."
  mapfile -t DNF_BASE < <(_read_manifest packages.dnf)
  _sudo dnf install -y "${DNF_BASE[@]}"

  if [ "$INSTALL_GUI" = true ]; then
    echo "🖥️  Installing Native GUI Applications..."
    mapfile -t DNF_GUI < <(_read_manifest gui.dnf)
    _sudo dnf install -y "${DNF_GUI[@]}"
  fi

  _install_linux_lifelines
  ;;

xbps)
  echo "⚡ Void Linux detected. Installing lifelines via xbps..."
  mapfile -t XBPS_BASE < <(_read_manifest packages.xbps)
  _sudo xbps-install -Sy "${XBPS_BASE[@]}"

  if [ "$INSTALL_GUI" = true ]; then
    echo "🖥️  Installing Native GUI Applications..."
    mapfile -t XBPS_GUI < <(_read_manifest gui.xbps)
    _sudo xbps-install -Sy "${XBPS_GUI[@]}"
  fi

  _install_linux_lifelines
  ;;

apk)
  echo "🏔️ Alpine detected. Using apk..."
  mapfile -t APK_BASE < <(_read_manifest packages.apk)
  _sudo apk add "${APK_BASE[@]}"
  ;;

winget)
  echo "🪟 Windows Git Bash detected. Bypassing UAC..."
  mkdir -p ~/.local/bin

  if _has winget; then
    winget import -i "$SCRIPT_DIR/packages/winget.json" --accept-package-agreements --accept-source-agreements || true
  fi

  # Ensure local bin is ready for portable binaries
  if [ -d "$HOME/.local/bin" ]; then
    chmod +x "$HOME/.local/bin"/* 2>/dev/null || true
  fi
  ;;

*)
  echo "⚠️  Unrecognized package manager ('$PKG_MGR'). Skipping OS-level lifelines; relying on mise only."
  ;;
esac

# starship isn't in the default apt/dnf repos (Debian 12, Fedora), so fall back to the upstream installer.
if ! _has starship && [[ "$PKG_MGR" =~ ^(apt|dnf|apk)$ ]]; then
  echo "⭐ Installing starship via upstream installer..."
  mkdir -p "$HOME/.local/bin"
  # TODO: pin a version + checksum instead of trusting the live install script.
  curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin" || echo "⚠️  starship install failed; continuing."
fi

# ==========================================
# 🧰 3. THE MISE POLYGLOT ENGINE
# ==========================================
echo ""
echo "========================================"
echo "🧰 Activating Mise-First Environment"
echo "========================================"

# --- Install Mise CLI ---
if ! _has mise && [ ! -f "$HOME/.local/bin/mise.exe" ] && [ ! -f "$HOME/.local/bin/mise" ]; then
  echo "⬇️ Downloading Mise..."

  if [ "$ENV_TYPE" = "windows" ]; then
    echo "🪟 Fetching Windows binary (Zip extraction)..."
    mkdir -p /tmp/mise_dl && cd /tmp/mise_dl

    # 1. Dynamically fetch the latest version number
    MISE_VER=$(curl -fsSL https://mise.jdx.dev/VERSION)
    echo "📦 Latest version detected: v$MISE_VER"

    # 2. Download the exact versioned zip file
    curl -sL "https://github.com/jdx/mise/releases/download/v${MISE_VER}/mise-v${MISE_VER}-windows-x64.zip" -o mise.zip

    # 3. Extract and install
    unzip -q mise.zip
    mkdir -p "$HOME/.local/bin"
    find . -name "mise*.exe" -exec mv {} "$HOME/.local/bin/" \;

    cd - >/dev/null
    rm -rf /tmp/mise_dl
  else
    # Native Linux / macOS installer
    # TODO: pin a version + checksum instead of trusting the live install script.
    curl -sS https://mise.run | sh
  fi
fi

# --- Inject Mise into the current PATH so we can run it immediately ---
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/bin:$HOME/.local/share/mise/shims:$PATH"

# --- Execute Provisioning ---
if _has mise || [ -f "$HOME/.local/bin/mise.exe" ] || [ -f "$HOME/.local/bin/mise" ]; then
  echo "🚀 Reading ~/.config/mise/config.toml and provisioning tools..."

  # 1. Automatically trust our native Linux/Mac/Windows dotfiles configurations
  for conf in "$HOME/.dotfiles/mise/.config/mise"/config*.toml "$HOME/.config/mise"/config*.toml; do
    if [ -f "$conf" ]; then
      mise trust "$conf" >/dev/null 2>&1 || true
    fi
  done

  # 2. If on WSL, dynamically find the Windows C:\ drive and trust it too
  if [ "$ENV_TYPE" = "wsl" ] && command -v wslpath >/dev/null 2>&1; then
    WIN_USERPROFILE=$(cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')
    if [ -n "$WIN_USERPROFILE" ]; then
      WIN_HOME=$(wslpath "$WIN_USERPROFILE")
      for conf in "$WIN_HOME/.config/mise"/config*.toml "$WIN_HOME/.dotfiles/mise/.config/mise"/config*.toml; do
        if [ -f "$conf" ]; then
          mise trust "$conf" >/dev/null 2>&1 || true
        fi
      done
    fi
  fi

  # 👇 THIS IS THE MAGIC LINE 👇
  # Treat WSL identical to Linux for CLI tools
  if [ "$ENV_TYPE" = "wsl" ]; then
    export MISE_ENV="linux"
  else
    export MISE_ENV="$ENV_TYPE"
  fi

  # Run the installation
  mise install -y

  # Ensure shims (executables) are generated and linked
  mise reshim
else
  echo "❌ Failed to install or locate Mise. Core CLI tools may be missing."
fi

echo "========================================"
echo "✅ Setup complete! Restart your terminal or run 'source ~/.profile && source ~/.bashrc'."
echo "========================================"
