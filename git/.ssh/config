# ==========================================
# ~/.ssh/config (Master Dotfiles)
# ==========================================

# 1. Personal GitHub
# Usage: git clone git@personal:User/repo.git
Host personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# 2. Org/Work GitHub
# Usage: git clone git@work:OrgName/repo.git
Host work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes

# 3. Alternate Personal GitHub
# Usage: git clone git@amandev.com:Aman/repo.git
Host amandev.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_amandev
  IdentitiesOnly yes
