#!/usr/bin/env bash
# Aman's Ultimate Environment Bootstrapper (Interactive & Automatable)

set -euo pipefail

# ==========================================
# ⚙️ 1. ARGUMENT PARSING & FLAGS
# ==========================================
AUTO_MODE=false
ENV_TYPE=""
INSTALL_GUI=false

while [[ "$#" -gt 0 ]]; do
  case $1 in
  --auto) AUTO_MODE=true ;;
  --gui) INSTALL_GUI=true ;;
  --env=*) ENV_TYPE="${1#*=}" ;;
  *)
    echo "Unknown parameter passed: $1"
    exit 1
    ;;
  esac
  shift
done

# If stdin is not a terminal (e.g., curl | bash) or /dev/tty isn't reachable
# (minimal containers, some CI runners), force AUTO_MODE — `read -p ... </dev/tty`
# would otherwise fail even when stdin itself looks like a tty.
if [ ! -t 0 ] || [ ! -r /dev/tty ]; then
  echo "⚠️ No interactive TTY available. Forcing Auto Mode."
  AUTO_MODE=true
fi

echo "========================================"
echo "🚀 Starting System Bootstrap..."
echo "========================================"

# --- Pre-flight: ensure core tools exist before we try to clone/fetch anything ---
# Runs before lib/detect.sh is available on disk, so it probes package managers inline.
# Fresh Debian WSL images in particular can ship without git, curl, or stow at all.
ensure_tool() {
  local tool="$1"
  command -v "$tool" >/dev/null 2>&1 && return 0

  local priv=""
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      priv="sudo"
    else
      echo "❌ $tool is missing and neither root nor sudo is available. Install $tool, then re-run." >&2
      exit 1
    fi
  fi

  echo "📦 $tool not found. Installing prerequisite..."
  # </dev/null: when piped (curl | bash), stdin is this script; keep installers from consuming it.
  if [ -n "${TERMUX_VERSION:-}" ] || command -v pkg >/dev/null 2>&1; then
    pkg update -y </dev/null && pkg install -y "$tool" </dev/null
  elif command -v apt-get >/dev/null 2>&1; then
    $priv apt-get update -y </dev/null && DEBIAN_FRONTEND=noninteractive $priv apt-get install -y "$tool" </dev/null
  elif command -v dnf >/dev/null 2>&1; then
    $priv dnf install -y "$tool" </dev/null
  elif command -v pacman >/dev/null 2>&1; then
    $priv pacman -Syu --noconfirm --needed "$tool" </dev/null
  elif command -v xbps-install >/dev/null 2>&1; then
    $priv xbps-install -Sy "$tool" </dev/null
  elif command -v apk >/dev/null 2>&1; then
    $priv apk add "$tool" </dev/null
  elif command -v brew >/dev/null 2>&1; then
    brew install "$tool" </dev/null
  else
    echo "❌ $tool is missing and no supported package manager was found. Install $tool, then re-run." >&2
    exit 1
  fi

  command -v "$tool" >/dev/null 2>&1 || { echo "❌ $tool installation failed." >&2; exit 1; }
}
ensure_tool git
ensure_tool curl
# stow's absence is handled later by falling back to ./link — don't force it here.

DOTFILES_DIR="$HOME/.dotfiles"

# ==========================================
# 📦 2. CLONE DOTFILES
# ==========================================
# Cloned BEFORE environment detection/menu so that lib/detect.sh and lib/backup.sh
# are guaranteed to exist on disk by the time anything needs to source them —
# this script itself may be running piped (curl | bash) with no local repo yet.
if [ ! -d "$DOTFILES_DIR" ]; then
  echo "📦 Cloning dotfiles repository..."
  git clone https://github.com/Aman1337g/dotfiles.git "$DOTFILES_DIR"
else
  echo "✅ Dotfiles repository already exists at $DOTFILES_DIR"
fi

cd "$DOTFILES_DIR" || exit 1
chmod +x install_tools link setup

# shellcheck source=lib/detect.sh
source "$DOTFILES_DIR/lib/detect.sh"
# shellcheck source=lib/backup.sh
source "$DOTFILES_DIR/lib/backup.sh"

# ==========================================
# 🧠 SMART AUTO-DETECTION
# ==========================================
DEFAULT_ENV="$(detect_env_type)"

export ENV_TYPE

# ==========================================
# 🗣️ 3. INTERACTIVE MENU (If not in --auto mode)
# ==========================================
if [ "$AUTO_MODE" = false ]; then
  echo ""
  echo "🤖 Welcome to the Environment Setup."

  if [ -z "$ENV_TYPE" ]; then
    echo "Select your target environment:"
    echo "  1) Linux (Native, Debian/Fedora/Void/Arch/...)"
    echo "  2) WSL (Windows Subsystem for Linux)"
    echo "  3) macOS"
    echo "  4) DevPod / Container (Ephemeral)"
    echo "  5) Windows Git Bash"
    # Force read from tty just in case
    read -r -p "Enter choice [1-5] (Default: $DEFAULT_ENV): " env_choice </dev/tty
    case $env_choice in
    1) ENV_TYPE="linux" ;;
    2) ENV_TYPE="wsl" ;;
    3) ENV_TYPE="mac" ;;
    4) ENV_TYPE="container" ;;
    5) ENV_TYPE="windows" ;;
    *) ENV_TYPE="$DEFAULT_ENV" ;;
    esac
  fi

  if [[ "$ENV_TYPE" =~ ^(linux|mac|wsl)$ ]]; then
    read -r -p "🖥️  Install GUI Desktop Apps (Kitty, Zathura, etc.)? (y/n): " gui_choice </dev/tty
    if [[ "$gui_choice" =~ ^[Yy]$ ]]; then
      INSTALL_GUI=true
    fi
  fi
else
  # In AUTO_MODE, if ENV_TYPE wasn't explicitly passed via flag, use the auto-detected one
  if [ -z "$ENV_TYPE" ]; then
    ENV_TYPE="$DEFAULT_ENV"
    echo "🤖 Auto-detected environment: $ENV_TYPE"
  fi
fi

# Termux always wins, regardless of what the menu/auto-detection landed on.
if [ -n "${TERMUX_VERSION:-}" ]; then
  ENV_TYPE="termux"
fi

export ENV_TYPE
export INSTALL_GUI
export AUTO_MODE

# ==========================================
# 🔗 4. LINKING (Done BEFORE installing tools so Mise has its config)
# ==========================================
echo ""
echo "========================================"
echo "🔗 Linking Dotfiles Configuration"
echo "========================================"

# Ensure stow is installed before trying to use it if on a brand new container
if ! command -v stow >/dev/null 2>&1; then
  echo "⚠️ GNU Stow not found. We will install it during the tool phase."
  echo "Falling back to safe link script for initial bootstrap..."
  ./link
else
  echo "✅ GNU Stow detected. Proceeding with modular links..."
  echo "  -> 🧹 Clearing runway for Stow (Handling old symlinks and defaults)..."
  SHOULD_INSTALL_GUI=false

  mkdir -p "$BACKUP_ROOT"

  for pair in "${CORE_LINKS[@]}"; do
    target="$HOME/${pair#*|}"
    if [ -L "$target" ]; then
      rm "$target" # Safely remove old symlinks
    elif [ -f "$target" ] || [ -d "$target" ]; then
      backup_existing "$target"
    fi
  done

  for rel in "${GUI_TARGETS[@]}"; do
    target="$HOME/$rel"
    if [ -L "$target" ]; then
      rm "$target"
    elif [ -f "$target" ] || [ -d "$target" ]; then
      backup_existing "$target"
    fi
  done

  echo "  -> 💻 Stowing Core CLI Tools..."
  stow --dir="$DOTFILES_DIR" --target="$HOME" bash scripts git nvim tmux starship fastfetch mise

  if [ "$INSTALL_GUI" = true ]; then
    SHOULD_INSTALL_GUI=true
  elif [[ "$ENV_TYPE" =~ ^(linux|mac)$ ]] && { [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; }; then
    SHOULD_INSTALL_GUI=true
  fi

  # Stow GUI only if requested
  if [ "$SHOULD_INSTALL_GUI" = true ]; then
    echo "  -> 🖥️  GUI Environment detected! Stowing Desktop Apps..."
    stow --dir="$DOTFILES_DIR" --target="$HOME" code kitty fonts sway yazi zathura qutebrowser

    if [ -f "scripts/scripts/install_themes" ]; then
      chmod +x scripts/scripts/install_themes
      ./scripts/scripts/install_themes
    fi
  fi

  prune_old_backups "$KEEP_BACKUPS"
  echo "🗂️  Backups stored under $BACKUP_ROOT"
fi

# ==========================================
# 🛠️ 5. UNIVERSAL TOOL INSTALLER (Mise First)
# ==========================================
echo ""
echo "========================================"
echo "🛠️  Running Universal Tool Installer..."
echo "========================================"

# Pass the flags down to the install script
INSTALL_ARGS=("--env=$ENV_TYPE")
if [ "$INSTALL_GUI" = true ]; then INSTALL_ARGS+=("--gui"); fi
if [ "$AUTO_MODE" = true ]; then INSTALL_ARGS+=("--auto"); fi

./install_tools "${INSTALL_ARGS[@]}"

echo "========================================"
echo "✨ Bootstrap Complete! Restart your terminal to see the magic."
echo "========================================"
